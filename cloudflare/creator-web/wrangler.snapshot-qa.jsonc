{
  "name": "creator-loop-b-snapshot-qa",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["python_workers"],
  "rules": [{"type": "ESModule", "globs": ["**/*.mjs"]}],
  "workers_dev": true,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "DATABASE", "class_name": "Database"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Database"]}],
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "version_metadata": {"binding": "CREATOR_VERSION"},
  "vars": {
    "B_WEB_OBSERVATION_ONLY": "1",
    "B_WEB_ISOLATED_RESTORE": "1",
    "B_WEB_QA_READONLY_LOGIN": "1",
    "B_WEB_QA_SNAPSHOT_EXPORT": "1",
    "B_WEB_QA_HOSTNAME": "creator-loop-b-snapshot-qa.creator-loop-ai-beta.workers.dev"
  }
}
